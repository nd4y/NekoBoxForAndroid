+	"github.com/netbirdio/netbird/shared/relay/client/dialer/ws"
+)
+
+type proxyDialer struct {
+	mu           sync.Mutex
+	addresses    []string
+	grpcListener *bufconn.Listener
+	wsListener   *bufconn.Listener
+}
+
+func (p *proxyDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	p.mu.Lock()
+	p.addresses = append(p.addresses, address)
+	p.mu.Unlock()
+	if network != "tcp" {
+		return nil, errors.New("unexpected non-TCP underlay")
+	}
+	switch address {
+	case "management.invalid:443":
+		return p.grpcListener.DialContext(ctx)
+	case "relay.invalid:80":
+		return p.wsListener.DialContext(ctx)
+	default:
+		return nil, errors.New("proxy rejected destination")
+	}
+}
+
