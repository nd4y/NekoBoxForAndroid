+		t.Fatal(err)
+	}
+
+	httpServer := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer c.CloseNow()
+		typ, msg, err := c.Read(ctx)
+		if err == nil {
+			_ = c.Write(ctx, typ, msg)
+		}
+	})}
+	go httpServer.Serve(p.wsListener)
+	defer httpServer.Close()
+	relay, err := (ws.Dialer{}).Dial(ctx, "rel://relay.invalid:80", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer relay.Close()
+	if _, err := relay.Write([]byte("encrypted-wireguard-payload")); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 128)
+	n, err := relay.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buf[:n]) != "encrypted-wireguard-payload" {
+		t.Fatal("relay payload changed")
+	}
+	if !peer.IsForceRelayed() {
+		t.Fatal("ICE is still permitted")
+	}
+
+	b := bind.NewICEBind(nil, wgaddr.Address{}, 1280)
+	receivers, _, err := b.Open(0)
