@@ -0,0 +1,63 @@
+package embed
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+// LookupIP resolves a name using the overlay's DNS service, never the host resolver.
+func (c *Client) LookupIP(ctx context.Context, host string) ([]net.IP, error) {
+	nsnet, _, err := c.getNet()
+	if err != nil {
+		return nil, err
+	}
+	hosts, err := nsnet.LookupContextHost(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	ips := make([]net.IP, 0, len(hosts))
+	for _, host := range hosts {
+		if ip := net.ParseIP(host); ip != nil {
+			ips = append(ips, ip)
+		}
+	}
+	return ips, nil
+}
+
+// ExchangeDNS forwards a complete wire-format DNS query to the overlay DNS service.
+// TCP avoids truncation and stays wholly within the userspace network stack.
+func (c *Client) ExchangeDNS(ctx context.Context, packet []byte) ([]byte, error) {
+	query := new(dns.Msg)
+	if err := query.Unpack(packet); err != nil {
+		return nil, fmt.Errorf("parse DNS query: %w", err)
+	}
+	engine, err := c.getEngine()
+	if err != nil {
+		return nil, err
+	}
+	addr, err := engine.DNSAddress()
+	if err != nil {
+		return nil, err
+	}
+	nsnet, err := engine.GetNet()
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	conn, err := nsnet.DialContext(ctx, "tcp", net.JoinHostPort(addr.String(), "53"))
+	if err != nil {
+		return nil, fmt.Errorf("dial overlay DNS: %w", err)
+	}
+	defer conn.Close()
+	client := &dns.Client{Net: "tcp", Timeout: 10 * time.Second}
+	response, _, err := client.ExchangeWithConnContext(ctx, query, &dns.Conn{Conn: conn})
+	if err != nil {
+		return nil, fmt.Errorf("exchange overlay DNS: %w", err)
+	}
+	return response.Pack()
+}
