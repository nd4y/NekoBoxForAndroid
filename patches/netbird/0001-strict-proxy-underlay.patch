+	}
+	ep := &wgconn.StdNetEndpoint{AddrPort: netip.MustParseAddrPort("192.0.2.1:51820")}
+	if err := b.Send([][]byte{{1, 2, 3}}, ep); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("direct WireGuard send: %v", err)
+	}
+	if err := b.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := nbnet.NewListener().ListenPacket(ctx, "udp", "127.0.0.1:0"); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("UDP listener bypass: %v", err)
+	}
+	release()
+	if _, err := nbnet.NewDialer().DialContext(ctx, "tcp", "management.invalid:443"); !errors.Is(err, underlay.ErrDirectBlocked) {
+		t.Fatalf("direct fallback after stop: %v", err)
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.addresses) != 2 || p.addresses[0] != "management.invalid:443" || p.addresses[1] != "relay.invalid:80" {
+		t.Fatalf("unexpected proxy destinations: %v", p.addresses)
+	}
+}
